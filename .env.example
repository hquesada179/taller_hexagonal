# Copiar este archivo como ".env" y ajustar los valores. NUNCA subir ".env" real al repositorio.

# --- MySQL (catalogo: recintos, eventos, asientos) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=stagepass
MYSQL_USER=stagepass_app
MYSQL_PASSWORD=stagepass_app_pwd
MYSQL_ROOT_PASSWORD=root_local_only

# --- MongoDB (reservas, ocupacion de asientos, boletos) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=stagepass
MONGO_USER=stagepass_app
MONGO_PASSWORD=stagepass_app_pwd
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_local_only
MONGO_AUTH_DB=stagepass

# --- Perfil activo de Spring ---
# "local" habilita endpoints de simulacion de pago y datos de demostracion.
SPRING_PROFILES_ACTIVE=local

# --- Seguridad de firma de boletos ---
# Clave maestra usada para derivar una clave HMAC distinta por cada evento.
# Debe ser un secreto largo y aleatorio en un entorno real; nunca se referencia desde el dominio.
STAGEPASS_HMAC_MASTER_SECRET=change-this-master-secret-in-production

# --- Proteccion de endpoints administrativos/demo ---
STAGEPASS_ADMIN_API_KEY=change-this-admin-key

# --- Reglas de negocio (valores por defecto documentados en el README) ---
STAGEPASS_BLOQUEO_MINUTOS=10
STAGEPASS_MAX_BOLETOS_POR_EVENTO=6
